# ─────────────────────────────────────────────────────────────────────────────
# Markets bots v2: one .env at the repo root, shared by the Python bots and the
# Next.js dashboard. Copy to .env and fill in. NEVER commit the real .env.
# ─────────────────────────────────────────────────────────────────────────────

# Shared secret between bots and dashboard (internal API header x-internal-secret).
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
API_SECRET=

# Encrypts the dashboard session cookie (falls back to API_SECRET if empty).
SESSION_SECRET=

# Keyed hash for Market verification network identifiers (keep it stable: changing it
# invalidates every stored identifier). Must be the same value used by v1.
MARKET_IP_HASH_SECRET=

# Optional: VPN / proxy detection for Market verification (https://ipinfo.io).
IPINFO_TOKEN=

# Public URL of the dashboard (HTTPS required for Market registration).
DASHBOARD_URL=https://dashboard.example.com
# Optional: override the registration URL (default: {DASHBOARD_URL}/bots/<bot>/auth/registro).
MARKET_REGISTRATION_URL=

LOG_LEVEL=INFO

# Bots managed by the dashboard (default: vapiano,hubstore,tradezone).
BOTS=vapiano,hubstore,tradezone

# ── Per-bot settings: <IDENTITY>_<KEY> ───────────────────────────────────────
# DATABASE_URL uses the Prisma format; the bots convert it for asyncpg automatically.
# CLIENT_SECRET is only needed by the dashboard (Discord OAuth login).
# Add https://<DASHBOARD_URL>/api/auth/callback as a redirect URI in each Discord application.

VAPIANO_BOT_TOKEN=
VAPIANO_CLIENT_ID=
VAPIANO_CLIENT_SECRET=
VAPIANO_GUILD_ID=
VAPIANO_DATABASE_URL=postgresql://user:password@localhost:5432/vapiano?schema=public
VAPIANO_INTERNAL_PORT=3011

HUBSTORE_BOT_TOKEN=
HUBSTORE_CLIENT_ID=
HUBSTORE_CLIENT_SECRET=
HUBSTORE_GUILD_ID=
HUBSTORE_DATABASE_URL=postgresql://user:password@localhost:5432/hubstore?schema=public
HUBSTORE_INTERNAL_PORT=3012

TRADEZONE_BOT_TOKEN=
TRADEZONE_CLIENT_ID=
TRADEZONE_CLIENT_SECRET=
TRADEZONE_GUILD_ID=
TRADEZONE_DATABASE_URL=postgresql://user:password@localhost:5432/tradezone?schema=public
TRADEZONE_INTERNAL_PORT=3013

# ── Optional ────────────────────────────────────────────────────────────────
# Where uploaded shop media lives (default: <repo>/uploads). Point it at v1's
# uploads folder to keep existing images working.
UPLOADS_DIR=
# Image used by /pago-colombia (default: <repo>/uploads/pago-colombia.jpg).
PAGO_COLOMBIA_IMAGE=
# Extra fonts for welcome / rank cards.
FONT_DIR=
# Emergency dashboard access via `npm run emergency-link` (keep false normally).
DASHBOARD_EMERGENCY_LOGIN=false
